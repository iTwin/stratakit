{
	"name": "@stratakit/icons",
	"type": "module",
	"version": "0.4.8",
	"license": "MIT",
	"sideEffects": false,
	"exports": {
		"./*": {
			"@stratakit/source": "./src/*.ts",
			"types": "./dist/*.d.ts",
			"default": "./dist/*.js"
		},
		"./*.svg": "./icons/*.svg",
		"./add-region.svg": "./icons/region-add.svg",
		"./collapse-rows-all.svg": "./icons/rows-collapse-all.svg",
		"./collapse-rows.svg": "./icons/rows-collapse.svg",
		"./define-region-size.svg": "./icons/region-define-size.svg",
		"./delete-columns.svg": "./icons/columns-delete.svg",
		"./delete-rows.svg": "./icons/rows-delete.svg",
		"./delete-table.svg": "./icons/table-delete.svg",
		"./expand-rows-all.svg": "./icons/rows-expand-all.svg",
		"./expand-rows.svg": "./icons/rows-expand.svg",
		"./gesture-one-finger-double-tap.svg": "./icons/gesture-double-tap-one-finger.svg",
		"./gesture-one-finger-drag.svg": "./icons/gesture-drag-one-finger.svg",
		"./gesture-one-finger-tap.svg": "./icons/gesture-tap-one-finger.svg",
		"./gesture-two-finger-drag.svg": "./icons/gesture-drag-two-finger.svg",
		"./gesture-two-finger-tap.svg": "./icons/gesture-tap-two-finger.svg",
		"./graph-scatter-chart.svg": "./icons/chart-scatter.svg",
		"./imodel-problematic-sync.svg": "./icons/imodel-sync-problematic.svg",
		"./merge-cells.svg": "./icons/cells-merge.svg",
		"./pipe-sewer.svg": "./icons/pipes-sewer.svg",
		"./pipe-water.svg": "./icons/pipes-water.svg",
		"./portable-water-pipes.svg": "./icons/pipes-water-portable.svg",
		"./profile.svg": "./icons/user-profile.svg",
		"./rule-delta-create.svg": "./icons/rule-create-delta.svg",
		"./rule-slope-create.svg": "./icons/rule-create-slope.svg",
		"./sewage-pipes.svg": "./icons/pipes-sewage.svg",
		"./sort-ascending.svg": "./icons/sorting-ascending-alpha.svg",
		"./sort-descending.svg": "./icons/sorting-descending-alpha.svg",
		"./split-cells.svg": "./icons/cells-split.svg",
		"./storm-water-pipes.svg": "./icons/pipes-water-storm.svg",
		"./table-column-insert-right.svg": "./icons/column-insert-right.svg",
		"./table-row-insert-below.svg": "./icons/row-insert-below.svg",
		"./vertex-mesh-add.svg": "./icons/vertex-add-mesh.svg",
		"./vertex-mesh-control.svg": "./icons/vertex-control-mesh.svg",
		"./icons-list.json": "./icons-list.json",
		"./icons-meta.json": "./icons-meta.json"
	},
	"files": [
		"dist",
		"icons/*.svg",
		"icons-list.json",
		"icons-meta.json",
		"LICENSE.md",
		"CHANGELOG.md"
	],
	"description": "A standalone SVG icon library for StrataKit",
	"author": "Bentley Systems",
	"homepage": "https://github.com/iTwin/stratakit",
	"repository": {
		"type": "git",
		"url": "https://github.com/iTwin/stratakit.git",
		"directory": "packages/icons"
	},
	"keywords": [
		"itwinui",
		"strata",
		"stratakit",
		"svg",
		"icons"
	],
	"scripts": {
		"build": "wireit",
		"test": "node --test scripts/icons.test.js"
	},
	"devDependencies": {
		"esbuild": "catalog:",
		"typescript": "catalog:"
	},
	"wireit": {
		"build": {
			"dependencies": [
				"build:js",
				"build:types",
				"build:icons-list"
			]
		},
		"build:js": {
			"command": "node scripts/build.js",
			"files": [
				"src",
				"scripts/build.js",
				"tsconfig.json",
				"../../internal/tsconfig*.json"
			],
			"output": [
				"dist/**/*.js"
			]
		},
		"build:types": {
			"command": "tsc --outDir dist",
			"files": [
				"src",
				"types.d.ts",
				"tsconfig.json",
				"../../internal/tsconfig*.json"
			],
			"output": [
				"dist/**/*.d.ts"
			]
		},
		"build:icons-list": {
			"command": "tsx scripts/icons-list.ts",
			"files": [
				"icons",
				"scripts/icons-list.ts"
			],
			"output": [
				"icons-list.json"
			]
		}
	}
}
