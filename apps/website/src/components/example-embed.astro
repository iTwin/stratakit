---
// This simply registers the `<example-embed>` element, which renders a React component.
---

<script>
	import { createElement } from "react";
	import { ExampleEmbed } from "./ExampleEmbed.tsx";
	import { mountPortal } from "./StrataKitRoot.tsx";

	customElements.define(
		"example-embed",
		class extends HTMLElement {
			#controller: AbortController | undefined;

			#previewSlot = document.createElement("slot");
			#sourceSlot = document.createElement("slot");

			constructor() {
				super();

				this.#previewSlot.name = "preview";
				this.#previewSlot.part.add("preview");

				this.#sourceSlot.part.add("source");
				this.#sourceSlot.hidden = true; // initially collapsed

				this.attachShadow({ mode: "open" }).append(this.#previewSlot, this.#sourceSlot);
			}

			connectedCallback() {
				this.#controller = new AbortController();

				const src = this.dataset.src;
				if (!src) return;

				const unmount = mountPortal({
					element: createElement(ExampleEmbed, {
						src,
						onSourceToggle: (expanded) => {
							this.#sourceSlot.hidden = !expanded;
						},
					}),
					target: this,
				});

				this.#controller.signal.onabort = () => unmount?.();
			}

			disconnectedCallback() {
				this.#controller?.abort();
			}
		},
	);
</script>

<style is:global>
	@layer page {
		example-embed {
			display: block;
			min-inline-size: 0;

			/* Reduce layout shift */
			&:not(:defined) {
				min-block-size: var(--example-min-height, 125px);

				> * {
					display: none;
				}
			}

			border-radius: var(--stratakit-radius-md);
			outline: 1px solid var(--stratakit-color-border-neutral-muted);
			background-color: var(--stratakit-color-bg-page-base);

			&::part(preview) {
				display: block;
				min-block-size: var(--example-min-height, 125px);
			}

			> [slot="preview"] {
				min-block-size: inherit;
			}

			> :not([slot="preview"]) {
				&:where(.expressive-code) {
					margin-block: 0;
					border-block-start: 1px solid var(--stratakit-color-border-neutral-muted);
					background-color: var(--stratakit-color-bg-page-depth);

					pre {
						border: 0;
					}
				}
			}
		}
	}
</style>
