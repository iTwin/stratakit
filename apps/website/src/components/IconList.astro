---
import iconsMeta from "@stratakit/icons/icons-meta.json";
import { svgDismiss } from "@stratakit/icons/dismiss";

const allIcons = import.meta.glob("/node_modules/@stratakit/icons/icons/*.svg", {
	query: "?url",
	eager: true,
});

function getIconHref(iconName: string) {
	const module = allIcons[`/node_modules/@stratakit/icons/icons/${iconName}.svg`];
	return (module as unknown as { default: string })?.default;
}

const iconMetaEntries = Object.entries(iconsMeta);

const defaultSymbol = "icon";
const allSymbols = [...new Set(iconMetaEntries.flatMap(([, meta]) => meta.symbols))];
---

<div>
	<input id="icon-search-input" type="search" placeholder="Search by name or alias" />
</div>
<div>
	<fieldset id="icon-symbol-filter">
		<legend>Filter by symbol</legend>
		<div class="chips">
			{
				allSymbols.map((symbol) => (
					<label>
						<input
							type="radio"
							name="symbol"
							value={symbol}
							checked={symbol === defaultSymbol ? true : undefined}
						/>
						<span>{symbol}</span>
					</label>
				))
			}
		</div>
	</fieldset>
</div>

<div id="icon-count" aria-live="polite" aria-atomic="true">
	Showing {iconMetaEntries.length} icons
</div>
<div role="list" class="icons-grid not-content">
	{
		iconMetaEntries.map(([iconName, meta]) => {
			const href = getIconHref(iconName);
			return (
				<div
					role="listitem"
					class="icon"
					data-icon={iconName}
					data-aliases={JSON.stringify(meta.aliases)}
					data-symbols={JSON.stringify(meta.symbols)}
					data-href={href}
				>
					<button command="show-modal" commandfor="icon-dialog">
						<svg width="16" height="16">
							<use href={`${href}#${defaultSymbol}`} />
						</svg>
						{iconName}
					</button>
				</div>
			);
		})
	}
	{/* These elements fill the empty space in the last row, to cover up the "gap decoration". */}
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
</div>

<dialog id="icon-dialog">
	<h2 data-name></h2>
	<button commandfor="icon-dialog" command="close" aria-label="Dismiss" class="icon-button">
		<svg width="16" height="16">
			<use href={svgDismiss}></use>
		</svg>
	</button>
	<h3>Symbols</h3>
	<ul data-symbols></ul>
	<h3>Aliases</h3>
	<ul data-aliases></ul>

	<template data-symbol-item>
		<li><svg><use></use></svg><span></span></li>
	</template>
	<template data-alias-item>
		<li></li>
	</template>
</dialog>

<style>
	@layer page {
		input[type="search"] {
			inline-size: 100%;
			min-block-size: var(--stratakit-size-control-field-height-medium);
			padding-inline: var(--stratakit-space-300);
			border: 1px solid var(--stratakit-color-border-page-base);
			border-radius: var(--stratakit-radius-sm);
		}

		fieldset {
			label {
				margin-top: 0;
				display: inline-flex;
				align-items: center;
				gap: var(--stratakit-space-100);
				min-block-size: var(--stratakit-size-control-field-height-small);
				padding-inline: var(--stratakit-space-200);
				border: 1px solid var(--stratakit-color-border-neutral-base);
				border-radius: 999px;
				cursor: pointer;

				&:hover {
					background-color: var(--stratakit-color-bg-glow-on-surface-neutral-hover);
				}

				&:has(input:focus-visible) {
					outline: 2px solid var(--stratakit-color-border-accent-strong);
					outline-offset: 1px;
				}

				input[type="radio"]:focus-visible:not(#a#b) {
					outline: unset !important;
				}
			}

			.chips {
				display: flex;
				gap: var(--stratakit-space-200);
				margin-top: var(--stratakit-space-50);
			}
		}

		.icons-grid {
			--_grid-bg: var(--stratakit-color-bg-page-depth);
			--_grid-line: var(--stratakit-color-border-neutral-muted);

			background-color: var(--_grid-bg);

			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: 1px;

			isolation: isolate;
			position: relative;

			/** This simulates a gap decoration (i.e. dividing lines). */
			&::before {
				content: "";
				position: absolute;
				inset: 1px;
				pointer-events: none;
				z-index: -1;

				background-color: var(--_grid-line);
			}

			.cover-it {
				background-color: var(--_grid-bg);
			}
		}

		.icon {
			margin: 0;

			display: grid;
			text-align: center;
			font-size: var(--stratakit-font-size-body-sm);
			overflow-wrap: anywhere;
			hyphens: auto;

			background-color: var(--_grid-bg);

			button {
				padding: var(--stratakit-space-400);
				display: grid;
				justify-items: center;
				justify-content: center;
				align-content: start;
				gap: var(--stratakit-space-200);
				outline-offset: -2px;
			}
		}

		svg {
			display: block;
			aspect-ratio: 1;
			color: var(--stratakit-color-icon-neutral-primary);
			inline-size: 1rem;

			&[data-size="large"] {
				inline-size: 1.5rem;
			}
		}

		dialog {
			box-shadow: var(--stratakit-shadow-surface-xl);
			border: 1px solid var(--stratakit-color-border-page-base);
			border-radius: var(--stratakit-radius-md);
			background-color: var(--stratakit-color-bg-elevation-level-1);
			inset: 0;
			place-self: center;

			&::backdrop {
				background-color: var(--stratakit-color-bg-elevation-overlay);
			}
		}

		.icon-button {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			min-inline-size: var(--stratakit-size-control-field-height-small);
			min-block-size: var(--stratakit-size-control-field-height-small);
			color: var(--stratakit-color-icon-neutral-base);
			border-radius: var(--stratakit-radius-sm);

			&:hover {
				color: var(--stratakit-color-icon-neutral-primary);
				background-color: var(--stratakit-color-bg-glow-on-surface-neutral-hover);
			}
		}
	}
</style>

<script>
	const debouncedFilter = debounce(filter, 200);

	const symbolInputs = document.querySelectorAll<HTMLInputElement>(
		"#icon-symbol-filter input[type='radio']",
	);
	for (const symbolInput of symbolInputs) {
		symbolInput.addEventListener("change", debouncedFilter);
	}

	const searchInput = document.querySelector<HTMLInputElement>("input[type='search']")!;
	searchInput.addEventListener("input", debouncedFilter);

	const iconDialog = document.querySelector<HTMLDialogElement>("#icon-dialog")!;
	iconDialog.addEventListener("click", (e) => {
		if (e.target !== e.currentTarget) return;
		iconDialog.close();
	});
	iconDialog.addEventListener("command", (e) => {
		if (!(e instanceof CommandEvent)) return;
		if (e.command !== "show-modal") return;

		const source = e.source;
		if (!(source instanceof HTMLElement)) return;

		const iconName = source.parentElement?.getAttribute("data-icon");
		if (!iconName) return;

		updateIconDialog(iconName);
		setIconParam(iconName);
	});
	iconDialog.addEventListener("close", () => {
		setIconParam(null);
	});

	window.addEventListener("popstate", syncIconParam);

	syncIconParam();

	function syncIconParam() {
		const iconName = new URLSearchParams(location.search).get("icon");

		if (iconName) {
			updateIconDialog(iconName);
			iconDialog.showModal();
			return;
		}

		iconDialog.close();
	}

	function setIconParam(iconName: string | null) {
		const url = new URL(location.href);
		const iconParam = url.searchParams.get("icon");
		if (iconParam === iconName) return;

		if (iconName) {
			url.searchParams.set("icon", iconName);
		} else {
			url.searchParams.delete("icon");
		}

		history.pushState(null, "", url);
	}

	function updateIconDialog(iconName: string) {
		const icon = document.querySelector<HTMLElement>(`[data-icon="${iconName}"]`);
		if (!icon) return;

		const heading = iconDialog.querySelector("[data-name]")!;
		heading.textContent = iconName;

		const symbols = JSON.parse(icon.getAttribute("data-symbols")!) as string[];
		const href = icon.getAttribute("data-href")!;
		const symbolItemTemplate = iconDialog.querySelector<HTMLTemplateElement>(
			"template[data-symbol-item]",
		)!;
		const symbolsElement = iconDialog.querySelector<HTMLUListElement>("[data-symbols]")!;
		symbolsElement.replaceChildren(
			...symbols.map((symbol) => {
				const symbolItem = symbolItemTemplate.content.cloneNode(true) as DocumentFragment;
				const svg = symbolItem.querySelector("svg")!;
				const size = getSize(symbol);
				updateIcon(svg, `${href}#${symbol}`, size);
				symbolItem.querySelector("span")!.textContent = symbol;
				return symbolItem;
			}),
		);

		const aliases = JSON.parse(icon.getAttribute("data-aliases")!) as string[];
		const aliasItemTemplate = iconDialog.querySelector<HTMLTemplateElement>(
			"template[data-alias-item]",
		)!;
		const aliasesElement = iconDialog.querySelector<HTMLUListElement>("[data-aliases]")!;
		aliasesElement.replaceChildren(
			...aliases.map((alias) => {
				const aliasItem = aliasItemTemplate.content.cloneNode(true) as DocumentFragment;
				aliasItem.querySelector("li")!.textContent = alias;
				return aliasItem;
			}),
		);
	}

	const icons = Array.from(document.querySelectorAll<HTMLElement>("[data-icon]"));

	function filter() {
		const query = searchInput.value;
		const selectedSymbol =
			document.querySelector<HTMLInputElement>("#icon-symbol-filter input:checked")?.value ??
			"icon";
		const size = getSize(selectedSymbol);

		let visibleIcons = 0;
		for (const icon of icons) {
			const iconName = icon.getAttribute("data-icon")!;
			const symbols = JSON.parse(icon.getAttribute("data-symbols")!) as string[];
			const aliases = JSON.parse(icon.getAttribute("data-aliases")!) as string[];
			const hasSymbol = symbols.includes(selectedSymbol);
			const matchesQuery = matchQuery(query, iconName, aliases);
			const visible = matchesQuery && hasSymbol;
			icon.hidden = !visible;

			if (!visible) continue;

			visibleIcons++;
			const svg = icon.querySelector<SVGElement>("svg")!;
			const href = icon.getAttribute("data-href")!;
			updateIcon(svg, `${href}#${selectedSymbol}`, size);
		}

		const countElement = document.getElementById("icon-count")!;
		countElement.textContent = `Showing ${visibleIcons} icons`;
	}

	function matchQuery(query: string, iconName: string, aliases: string[]) {
		query = query.trim().toLowerCase();
		iconName = iconName.toLowerCase();

		if (!query) return true;
		if (iconName.includes(query)) return true;
		return aliases.some((alias) => alias.toLowerCase().includes(query));
	}

	function getSize(symbol: string) {
		return symbol.includes("-large") ? "large" : "regular";
	}

	function updateIcon(svg: SVGElement, href: string, size: "regular" | "large") {
		const width = size === "large" ? "24px" : "16px";

		svg.setAttribute("width", width);
		svg.setAttribute("height", width);
		svg.setAttribute("data-size", size);

		const use = svg.querySelector<SVGUseElement>("use")!;
		use.setAttribute("href", href);
	}

	function debounce<Args extends unknown[]>(fn: (...args: Args) => void, delay: number) {
		let timeout: ReturnType<typeof setTimeout>;
		return (...args: Args) => {
			clearTimeout(timeout);
			timeout = setTimeout(() => fn(...args), delay);
		};
	}
</script>
