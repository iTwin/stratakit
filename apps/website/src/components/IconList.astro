---
import iconsMeta from "@stratakit/icons/icons-meta.json";

const allIcons = import.meta.glob("/node_modules/@stratakit/icons/icons/*.svg", {
	query: "?url",
	eager: true,
});

function getIconHref(iconName: string) {
	const module = allIcons[`/node_modules/@stratakit/icons/icons/${iconName}.svg`];
	return (module as unknown as { default: string })?.default;
}

const iconMetaEntries = Object.entries(iconsMeta);

const defaultSymbol = "icon";
const allSymbols = [...new Set(iconMetaEntries.flatMap(([, meta]) => meta.symbols))];
---

<fieldset data-symbol-filter>
	<legend>Filter by symbol</legend>
	<div>
		{
			allSymbols.map((symbol) => (
				<label>
					<input
						type="radio"
						name="symbol"
						value={symbol}
						checked={symbol === defaultSymbol ? true : undefined}
					/>
					<span>{symbol}</span>
				</label>
			))
		}
	</div>
</fieldset>
<div role="list" class="icons-grid not-content">
	{
		iconMetaEntries.map(([iconName, meta]) => {
			return (
				<div role="listitem" class="icon">
					<button
						command="show-modal"
						commandfor="icon-dialog"
						data-icon-name={iconName}
						data-aliases={JSON.stringify(meta.aliases)}
						data-symbols={JSON.stringify(meta.symbols)}
					>
						<svg width="16" height="16" data-size="regular">
							{meta.symbols.map((symbol) => {
								return (
									<use
										href={`${getIconHref(iconName)}#${symbol}`}
										data-symbol={symbol}
										display={symbol === defaultSymbol ? undefined : "none"}
									/>
								);
							})}
						</svg>
						{iconName}
					</button>
				</div>
			);
		})
	}
	{/* These elements fill the empty space in the last row, to cover up the "gap decoration". */}
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
	<div class="cover-it" role="none"></div>
</div>

<dialog id="icon-dialog">
	<h2 data-name></h2>
	<h3>Symbols</h3>
	<ul data-symbols></ul>
	<h3>Aliases</h3>
	<ul data-aliases></ul>
	<button commandfor="icon-dialog" command="close">Close</button>

	<template data-alias-item>
		<li></li>
	</template>
	<template data-symbol-item>
		<li></li>
	</template>
</dialog>

<style>
	@layer page {
		.icons-grid {
			--_grid-bg: var(--stratakit-color-bg-page-depth);
			--_grid-line: var(--stratakit-color-border-neutral-muted);

			background-color: var(--_grid-bg);

			display: grid;
			grid-template-columns: repeat(auto-fill, minmax(120px, 1fr));
			gap: 1px;

			isolation: isolate;
			position: relative;

			/** This simulates a gap decoration (i.e. dividing lines). */
			&::before {
				content: "";
				position: absolute;
				inset: 1px;
				pointer-events: none;
				z-index: -1;

				background-color: var(--_grid-line);
			}

			.cover-it {
				background-color: var(--_grid-bg);
			}
		}

		.icon {
			margin: 0;
			padding: var(--stratakit-space-400);

			text-align: center;
			font-size: var(--stratakit-font-size-body-sm);
			overflow-wrap: anywhere;
			hyphens: auto;

			display: grid;
			justify-items: center;
			justify-content: center;
			align-content: start;
			gap: var(--stratakit-space-200);

			background-color: var(--_grid-bg);
		}

		svg {
			display: block;
			aspect-ratio: 1;
			color: var(--stratakit-color-icon-neutral-primary);

			&[data-size="regular"] {
				inline-size: 1rem;
			}

			&[data-size="large"] {
				inline-size: 1.5rem;
			}
		}

		dialog {
			box-shadow: var(--stratakit-shadow-surface-xl);
			border: 1px solid var(--stratakit-color-border-page-base);
			border-radius: var(--stratakit-radius-md);
			background-color: var(--stratakit-color-bg-elevation-level-1);
			inset: 0;
			place-self: center;

			&::backdrop {
				background-color: var(--stratakit-color-bg-elevation-overlay);
			}
		}
	}
</style>

<script>
	const symbolInputs = document.querySelectorAll<HTMLInputElement>(
		"[data-symbol-filter] input[type='radio']",
	);
	for (const symbolInput of symbolInputs) {
		symbolInput.addEventListener("change", filter);
	}

	const iconDialog = document.querySelector<HTMLDialogElement>("#icon-dialog")!;
	iconDialog.addEventListener("click", (e) => {
		if (e.target !== e.currentTarget) return;
		iconDialog.close();
	});
	iconDialog.addEventListener("command", (e) => {
		if (!(e instanceof CommandEvent)) return;
		if (e.command !== "show-modal") return;

		const source = e.source;
		if (!(source instanceof HTMLElement)) return;

		const iconName = source.getAttribute("data-icon-name");
		if (!iconName) return;

		updateIconDialog(iconName);
	});

	function updateIconDialog(iconName: string) {
		const iconButton = document.querySelector<HTMLButtonElement>(`[data-icon-name="${iconName}"]`);
		if (!iconButton) return;

		const heading = iconDialog.querySelector("[data-name]")!;
		heading.textContent = iconName;

		const symbols = JSON.parse(iconButton.getAttribute("data-symbols")!) as string[];
		const symbolItemTemplate = iconDialog.querySelector<HTMLTemplateElement>(
			"template[data-symbol-item]",
		)!;
		const symbolsElement = iconDialog.querySelector<HTMLUListElement>("[data-symbols]")!;
		symbolsElement.replaceChildren(
			...symbols.map((symbol) => {
				const symbolItem = symbolItemTemplate.content.cloneNode(true) as DocumentFragment;
				symbolItem.querySelector("li")!.textContent = symbol;
				return symbolItem;
			}),
		);

		const aliases = JSON.parse(iconButton.getAttribute("data-aliases")!) as string[];
		const aliasItemTemplate = iconDialog.querySelector<HTMLTemplateElement>(
			"template[data-alias-item]",
		)!;
		const aliasesElement = iconDialog.querySelector<HTMLUListElement>("[data-aliases]")!;
		aliasesElement.replaceChildren(
			...aliases.map((alias) => {
				const aliasItem = aliasItemTemplate.content.cloneNode(true) as DocumentFragment;
				aliasItem.querySelector("li")!.textContent = alias;
				return aliasItem;
			}),
		);
	}

	const icons = Array.from(document.querySelectorAll<HTMLElement>(".icon"));

	function filter() {
		const selectedSymbol =
			document.querySelector<HTMLInputElement>("[data-symbol-filter] input:checked")?.value ??
			"icon";
		const isLarge = selectedSymbol.includes("-large");
		const size = isLarge ? "24px" : "16px";

		for (const icon of icons) {
			const symbolElements = icon.querySelectorAll<SVGElement>("[data-symbol]");
			const selectedSymbolElement = Array.from(symbolElements).find(
				(el) => el.getAttribute("data-symbol") === selectedSymbol,
			);
			icon.hidden = !selectedSymbolElement;

			const svg = icon.querySelector<SVGElement>("svg")!;
			svg.setAttribute("width", size);
			svg.setAttribute("height", size);
			svg.setAttribute("data-size", isLarge ? "large" : "regular");

			symbolElements.forEach((el) => el.setAttribute("display", "none"));
			selectedSymbolElement?.removeAttribute("display");
		}
	}
</script>
